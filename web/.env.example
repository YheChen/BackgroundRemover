# Where the ONNX weights are served from.
# Leave unset for local dev (uses public/models/birefnet-lite.onnx).
#
# For a deployed site, host the model somewhere built for large static blobs
# and set this. Hugging Face is free, CDN-backed, unlimited bandwidth for
# public repos, and already sends permissive CORS headers:
#
# VITE_MODEL_URL=https://huggingface.co/<you>/bgremover-onnx/resolve/main/birefnet-lite-int8.onnx
#
# A GitHub Release asset also works and is CORS-enabled:
# VITE_MODEL_URL=https://github.com/<you>/BackgroundRemover/releases/download/v0.1.0/birefnet-lite-int8.onnx
